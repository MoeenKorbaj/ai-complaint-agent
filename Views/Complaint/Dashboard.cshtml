@model List<AIComplaintAgent.Models.ComplaintResultModel>

@{
    ViewData["Title"] = "Dashboard";
    var highCount = Model.Count(c => c.Priority == "High");
    var mediumCount = Model.Count(c => c.Priority == "Medium");
    var lowCount = Model.Count(c => c.Priority == "Low");
    var negativeCount = Model.Count(c => c.Sentiment == "Negative");
}

<div class="container mt-4">

    <h3 class="mb-4">📊 Complaints Dashboard</h3>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-0 bg-light">
                <div class="card-body">
                    <h2 class="fw-bold">@Model.Count</h2>
                    <small class="text-muted">Total Complaints</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 bg-danger bg-opacity-10">
                <div class="card-body">
                    <h2 class="fw-bold text-danger">@highCount</h2>
                    <small class="text-muted">High Priority</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 bg-warning bg-opacity-10">
                <div class="card-body">
                    <h2 class="fw-bold text-warning">@mediumCount</h2>
                    <small class="text-muted">Medium Priority</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 bg-danger bg-opacity-10">
                <div class="card-body">
                    <h2 class="fw-bold text-danger">@negativeCount</h2>
                    <small class="text-muted">Negative Sentiment</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Complaints Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Recent Complaints</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Sentiment</th>
                        <th>Priority</th>
                        <th>Action</th>
                        <th>Date</th>
                        <th>Details</th>
                        <th>Status</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var complaint in Model)
                    {
                        var priorityBadge = complaint.Priority switch
                        {
                            "High" => "danger",
                            "Medium" => "warning",
                            _ => "success"
                        };
                        var sentimentBadge = complaint.Sentiment switch
                        {
                            "Negative" => "danger",
                            "Positive" => "success",
                            _ => "secondary"
                        };
                        <tr>
                            <td>@complaint.Id</td>
                            <td>
                                <strong>@complaint.CustomerName</strong>
                                <br />
                                <small class="text-muted">@complaint.Email</small>
                            </td>
                            <td>@complaint.Type</td>
                            <td>
                                <span class="badge bg-@sentimentBadge">
                                    @complaint.Sentiment
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@priorityBadge">
                                    @complaint.Priority
                                </span>
                            </td>
                            <td>
                                <small>@complaint.DecidedAction</small>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @complaint.CreatedAt.ToString("MMM dd, HH:mm")
                                </small>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@complaint.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (complaint.Status == "Open")
                                    {
                                        <span class="badge bg-danger px-2 py-1">New</span>
                                        <a asp-action="UpdateStatus"
                                           asp-route-id="@complaint.Id"
                                           asp-route-status="InProgress"
                                           class="btn btn-sm btn-primary">
                                            Start →
                                        </a>
                                    }
                                    else if (complaint.Status == "InProgress")
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">In Progress</span>
                                        <a asp-action="UpdateStatus"
                                           asp-route-id="@complaint.Id"
                                           asp-route-status="Resolved"
                                           class="btn btn-sm btn-success">
                                            Resolve ✅
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-2 py-1">Resolved ✅</span>
                                    }
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>